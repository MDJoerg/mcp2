    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>GET_META</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>The request _meta object</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>GET_REF_NAME</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Prompt name (only when ref/prompt)</DESCRIPT>
