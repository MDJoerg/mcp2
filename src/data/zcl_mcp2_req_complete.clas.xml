    <SEOCOMPOTX>
     <CMPNAME>GET_REF_TYPE</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Reference kind: ref/prompt or ref/resource</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>GET_REF_URI</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Resource URI (only when ref/resource)</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>HAS_CONTEXT</CMPNAME>
     <LANGU>E</LANGU>
     <DESCRIPT>Whether resolved-argument context was supplied</DESCRIPT>
